<footer class="auf-foot">
  <div class="auf-foot__wrap">
    <div class="auf-foot__top">
      <div class="auf-foot__brand">
        <a class="auf-foot__logo" href="{{ routes.root_url }}">Vardagshoppen</a>
        <p>Tasstvättkitet för en renare hall efter promenaden. Ett UF-företag inom Ung Företagsamhet.</p>
        {%- form 'customer', class: 'auf-foot__news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="AufNewsEmail">Få nyheter och erbjudanden först</label>
          {%- if form.posted_successfully? -%}
            <p class="auf-foot__ok" role="status">Tack! Du är nu med på vår lista. Du kan avsluta när som helst via länken i våra mejl.</p>
          {%- else -%}
            <div class="auf-foot__field">
              <input id="AufNewsEmail" type="email" name="contact[email]" placeholder="Din e-postadress" autocomplete="email" required aria-describedby="AufNewsConsent{% if form.errors %} AufNewsError{% endif %}"{% if form.errors %} aria-invalid="true"{% endif %}>
              <button type="submit">Prenumerera</button>
            </div>
            {%- if form.errors -%}<p id="AufNewsError" class="auf-foot__err" role="alert">Kontrollera e-postadressen och försök igen.</p>{%- endif -%}
            <p id="AufNewsConsent" class="auf-foot__consent">Genom att prenumerera säger du ja till att få nyheter och erbjudanden från oss via e-post. Du kan avsluta när som helst via länken i varje mejl. Läs mer i vår <a href="/pages/integritetspolicy">integritetspolicy</a>.</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <nav class="auf-foot__col" aria-label="Kundservice">
        <h3>Kundservice</h3>
        <ul>
          <li><a href="/pages/contact">Kontakta oss</a></li>
          <li><a href="/pages/frakt-och-retur">Frakt och retur</a></li>
          <li><a href="/pages/kopvillkor">Köpvillkor</a></li>
          <li><a href="/pages/integritetspolicy">Integritetspolicy och cookies</a></li>
          <li><button type="button" class="auf-foot__linkbtn" onclick="if(window.privacyBanner){window.privacyBanner.showPreferences()}else{location.href='/pages/integritetspolicy'}">Cookie-inställningar</button></li>
        </ul>
      </nav>

      <nav class="auf-foot__col" aria-label="Tasstvättkitet">
        <h3>Tasstvättkitet</h3>
        <ul>
          <li><a href="/#kop">Välj storlek och färg</a></li>
          <li><a href="/#sa-funkar">Så funkar det</a></li>
          <li><a href="/products/tasstvattkit-sma-och-mellanstora-hundar">Storleksguide och mått</a></li>
          <li><a href="/#fragor">Vanliga frågor</a></li>
        </ul>
      </nav>

      <nav class="auf-foot__col" aria-label="Om Vardagshoppen">
        <h3>Om Vardagshoppen</h3>
        <ul>
          <li><a href="/pages/om-oss">Om oss</a></li>
          <li><a href="https://ungforetagsamhet.se" target="_blank" rel="noopener">Ung Företagsamhet</a></li>
        </ul>
        <h3 class="auf-foot__h-gap">Kontakt</h3>
        <p class="auf-foot__small">Agent UF (UF-företag)<br>Beckastigen 15, 892 40 Domsjö<br><a href="mailto:valleonlinejobb@gmail.com">valleonlinejobb@gmail.com</a><br>Vi svarar oftast inom en vardag.</p>
      </nav>
    </div>

    <ul class="auf-foot__usps">
      <li>Frakt 29 kr – fri frakt från 349 kr</li>
      <li>Leverans 1–4 vardagar med PostNord</li>
      <li>Storleksgaranti</li>
      <li>14 dagars ångerrätt</li>
    </ul>

    <div class="auf-foot__bottom">
      <p>© {{ 'now' | date: '%Y' }} Vardagshoppen · drivs av Agent UF, UF-företag inom Ung Företagsamhet</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="auf-foot__pay" aria-label="Betalsätt">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  .auf-foot { background:#183f36; color:#e2e9df; font-size:.92rem; }
  .auf-foot a { color:#fff; text-decoration:none; }
  .auf-foot a:hover { text-decoration:underline; }
  .auf-foot a:focus-visible, .auf-foot button:focus-visible, .auf-foot input:focus-visible { outline:3px solid #fff; outline-offset:3px; }
  .auf-foot__wrap { max-width:1200px; margin:0 auto; padding:64px 20px 28px; }
  .auf-foot__top { display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr; gap:40px; }
  .auf-foot__logo { font-size:1.5rem; font-weight:800; letter-spacing:-.02em; }
  .auf-foot__brand p { margin:12px 0 22px; max-width:38ch; line-height:1.55; }
  .auf-foot__news label { display:block; color:#fff; font-weight:600; margin-bottom:10px; }
  .auf-foot__field { display:flex; background:#fff; border-radius:999px; padding:4px; max-width:420px; }
  .auf-foot__field input { flex:1; min-width:0; border:0; background:transparent; padding:10px 14px; font:inherit; color:#111; }
  .auf-foot__field input::placeholder { color:#5c5c5c; opacity:1; }
  .auf-foot__field button { border:0; border-radius:999px; background:#1e5c4a; color:#fff; font:inherit; font-weight:600; min-height:44px; padding:10px 18px; cursor:pointer; }
  .auf-foot__field button:hover { background:#174a3b; }
  .auf-foot__field:focus-within { box-shadow:0 0 0 3px #fff; }
  .auf-foot__field input:focus-visible { outline:none; }
  .auf-foot__brand .auf-foot__consent { font-size:.875rem; line-height:1.55; margin:10px 0 0; max-width:420px; color:#e2e9df; }
  .auf-foot__consent a { text-decoration:underline; }
  .auf-foot__ok { color:#9fd6c2; font-weight:600; }
  .auf-foot__brand .auf-foot__err { color:#ffc9c9; font-weight:600; margin:10px 0 0; }
  .auf-foot__col h3 { color:#fff; font-size:.8rem; text-transform:uppercase; letter-spacing:.12em; margin:0 0 16px; }
  .auf-foot__h-gap { margin-top:28px !important; }
  .auf-foot__col ul { list-style:none; padding:0; margin:0; display:grid; gap:10px; }
  .auf-foot__col a, .auf-foot__linkbtn { color:#d9d9d9; }
  .auf-foot__col a:hover, .auf-foot__linkbtn:hover { color:#fff; }
  .auf-foot__linkbtn { background:none; border:0; padding:0; font:inherit; cursor:pointer; text-align:left; }
  .auf-foot__linkbtn:hover { text-decoration:underline; }
  .auf-foot__small { margin:0; line-height:1.6; }
  .auf-foot__usps { list-style:none; padding:22px 0; margin:48px 0 0; border-top:1px solid #2a2a2a; border-bottom:1px solid #2a2a2a; display:flex; flex-wrap:wrap; gap:12px 32px; color:#fff; font-weight:500; }
  .auf-foot__usps li::before { content:"✓"; color:#6fc2a5; margin-right:8px; font-weight:700; }
  .auf-foot__bottom { display:flex; justify-content:space-between; align-items:center; gap:16px; flex-wrap:wrap; padding-top:22px; font-size:.82rem; color:#c4ccc8; }
  .auf-foot__bottom p { margin:0; }
  .auf-foot__pay { list-style:none; display:flex; flex-wrap:wrap; gap:6px; padding:0; margin:0; }
  .auf-foot__pay svg { width:38px; height:24px; display:block; }
  @media (max-width:900px) {
    .auf-foot__top { grid-template-columns:1fr 1fr; gap:32px; }
    .auf-foot__brand { grid-column:1 / -1; }
  }
  @media (max-width:520px) { .auf-foot__top { grid-template-columns:1fr; } .auf-foot__wrap { padding-top:48px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Vardagshoppen – sidfot",
  "settings": [],
  "presets": [{ "name": "Vardagshoppen – sidfot" }]
}
{% endschema %}
